{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mola",
  "version": "0.1.0",
  "identifier": "app.mola.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mola",
        "width": 480,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "reminder",
        "title": "Mola",
        "width": 360,
        "height": 236,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "furkan-uysal",
    "copyright": "© 2026 furkan-uysal. MIT License.",
    "category": "Productivity",
    "shortDescription": "Water and stand-up reminder for Windows",
    "longDescription": "Mola reminds you to drink water and to get up from your desk. It resets the sitting timer when you step away, limits snoozes, and stays quiet during calls and fullscreen apps.",
    "homepage": "https://github.com/furkanuysl/Mola",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
